{
  "version": 1,
  "description": "Known Answer Tests for Pack Companions email_hash recipe. Locks the canonical hashing wire-equivalent across the service (app/services/identity.hash_email), Python SDK (pack_companions.hash_email), and JS SDK (@pack-companions/companions hashEmail). All three implementations MUST produce these exact digests given these inputs. Updates require updating ALL THREE test suites — by design. Recipe: sha256(email.strip().lower()).hexdigest().",
  "recipe": "sha256(email.strip().lower()).hexdigest()",
  "vectors": [
    {
      "name": "simple_ascii",
      "input": "alice@example.com",
      "expected": "ff8d9819fc0e12bf0d24892e45987e249a28dce836a85cad60e28eaaa8c6d976"
    },
    {
      "name": "mixed_case_normalizes_to_same",
      "input": "Alice@EXAMPLE.com",
      "expected": "ff8d9819fc0e12bf0d24892e45987e249a28dce836a85cad60e28eaaa8c6d976"
    },
    {
      "name": "leading_trailing_whitespace_stripped",
      "input": "  alice@example.com  ",
      "expected": "ff8d9819fc0e12bf0d24892e45987e249a28dce836a85cad60e28eaaa8c6d976"
    },
    {
      "name": "tabs_newlines_case_combined",
      "input": "\tAlice@Example.COM\n",
      "expected": "ff8d9819fc0e12bf0d24892e45987e249a28dce836a85cad60e28eaaa8c6d976"
    },
    {
      "name": "distinct_email_gets_distinct_digest",
      "input": "bob@example.com",
      "expected": "5ff860bf1190596c7188ab851db691f0f3169c453936e9e1eba2f9a47f7a0018"
    },
    {
      "name": "plus_alias_NOT_stripped",
      "input": "user+tag@example.com",
      "expected": "80e9aafb240be8b158f55455c7b056ac48d1cb9fe4d0bd7e244e0f26547d7dce"
    },
    {
      "name": "plus_alias_base_distinct_from_aliased",
      "input": "user@example.com",
      "expected": "b4c9a289323b21a01c3e940f150eb9b8c542587f1abfd8f0e1cc1ffc5e475514"
    },
    {
      "name": "unicode_local_part",
      "input": "тест@example.com",
      "expected": "e17154b40a25b5ac03d8922d035a6fe9edae3098a09ce5f1ac9de460eb903d94"
    },
    {
      "name": "empty_string_hashes_to_sha256_of_empty",
      "input": "",
      "expected": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    }
  ]
}
